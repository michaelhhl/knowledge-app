# 复制为 .env 后填写。.env 已在 .gitignore 中，不要提交。
# 格式为 KEY=VALUE，值两侧不要加引号。

# 知识根目录；留空时依次尝试 ./knowledge 与 ../knowledge
KNOWLEDGE_ROOT=

# 索引目录；留空时使用知识根目录同级的 .local/index
INDEX_DIR=

# LLM（第一版无默认提供商；四项都填写后问答才启用）
# LLM_PROVIDER 目前支持 openai-compatible（OpenAI Chat Completions 兼容接口）
# 示例：OpenAI      LLM_BASE_URL=https://api.openai.com/v1
#       DeepSeek    LLM_BASE_URL=https://api.deepseek.com/v1
#       本地 Ollama LLM_BASE_URL=http://localhost:11434/v1 （LLM_API_KEY 可填任意非空值）
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# 问答响应是否附带检索摘要（FR-07）
QA_SHOW_RETRIEVAL=true

# BM25 分数阈值，低于该值视为无依据
RETRIEVAL_MIN_SCORE=0.5
